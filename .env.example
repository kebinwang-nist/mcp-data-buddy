# Copy to .env and fill in real values. Do NOT commit .env.

# Required for app.py and the web client.
# AI_API_KEY=your-api-key
# AI_API_BASE=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# Separate model for the gateway's PII check (gateway_config.json -> ai_check).
# Each unset value falls back to the AI_* value above.
# GATEWAY_AI_API_KEY=your-api-key
# GATEWAY_AI_API_BASE=https://api.openai.com/v1
# GATEWAY_AI_MODEL=gpt-4o-mini

# MCP server endpoints are configured in server_config.json, not here.

# NiceGUI web client (client/). No authentication: keep it on localhost.
# CLIENT_HOST=127.0.0.1
# CLIENT_PORT=8080
# CLIENT_TITLE=MCP Data Buddy
# CLIENT_SHOW_BROWSER=true
